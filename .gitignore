# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/storybook-static/
/artifacts/ui-review/

# deprecated design screenshots/concepts; canonical references live in docs/designs/references/
/docs/designs/assets/product-ui-redesign/*.png
/docs/designs/generated/page-redesigns/**/*.png

# next.js
/.next/
/next-env.d.ts
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/outputs/
/work/
/tmp/
/generated/prisma/
/src/shared/db/generated/prisma/

# local build/type-check artifacts
*.tsbuildinfo

# local security audit evidence; canonical redacted findings live in F029 decisions/tasks
/docs/features/*/F*-cso-security-audit/security-posture.md

# Python service environments and caches
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
*.py[cod]
