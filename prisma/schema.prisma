generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecordingKind {
  USER_TEST
  SONG_SOURCE
  SVC_REFERENCE
  SVC_TARGET
}

enum RecordingStatus {
  PENDING
  READY
  FAILED
  DELETED
}

enum VocalProfileSourceType {
  USER
  SONG
}

enum SongAnalysisStatus {
  PENDING
  READY
  FAILED
}

enum SynthesisStatus {
  PREPARING
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

model Recording {
  id            String          @id @default(uuid()) @db.Uuid
  kind          RecordingKind
  storagePath   String
  mimeType      String
  durationMs    Int?
  sizeBytes     BigInt?
  sampleRate    Int?
  status        RecordingStatus @default(PENDING)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  expiresAt     DateTime?
  vocalProfiles VocalProfile[]

  @@index([kind, status])
  @@index([createdAt])
  @@index([expiresAt])
}

model VocalProfile {
  id                 String                 @id @default(uuid()) @db.Uuid
  userId             String?
  sourceType         VocalProfileSourceType
  recordingId        String                 @db.Uuid
  minMidi            Float?
  maxMidi            Float?
  p10Midi            Float?
  medianMidi         Float?
  p90Midi            Float?
  tessituraLowMidi   Float?
  tessituraHighMidi  Float?
  voicedRatio        Float?
  pitchStability     Float?
  clippingRatio      Float?
  rmsDb              Float?
  descriptors        Json?
  analyzer           String
  analyzerVersion    String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  recording          Recording              @relation(fields: [recordingId], references: [id], onDelete: Restrict)
  user               User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  song               Song?
  recommendationRuns RecommendationRun[]

  @@unique([recordingId, analyzer, analyzerVersion])
  @@index([userId, createdAt])
  @@index([sourceType, createdAt])
}

model Song {
  id                  String               @id @default(uuid()) @db.Uuid
  title               String
  artist              String
  originalKey         String?
  catalogOrder        Int                  @unique
  vocalProfileId      String?              @unique @db.Uuid
  analysisStatus      SongAnalysisStatus   @default(PENDING)
  metadata            Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  vocalProfile        VocalProfile?        @relation(fields: [vocalProfileId], references: [id], onDelete: SetNull)
  recommendationItems RecommendationItem[]

  @@unique([title, artist])
  @@index([analysisStatus, catalogOrder])
}

model RecommendationRun {
  id                 String               @id @default(uuid()) @db.Uuid
  userId             String?
  userVocalProfileId String               @db.Uuid
  scoringVersion     String
  createdAt          DateTime             @default(now())
  userVocalProfile   VocalProfile         @relation(fields: [userVocalProfileId], references: [id], onDelete: Restrict)
  user               User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items              RecommendationItem[]

  @@index([userId, createdAt])
  @@index([userVocalProfileId, createdAt])
}

model RecommendationItem {
  id                   String            @id @default(uuid()) @db.Uuid
  runId                String            @db.Uuid
  songId               String            @db.Uuid
  rank                 Int
  originalKeyScore     Float
  adjustedScore        Float
  recommendedShift     Int
  reasonCodes          Json
  metrics              Json
  synthesisStatus      SynthesisStatus?
  synthesisJobId       String?
  synthesisErrorCode   String?
  synthesisErrorDetail String?
  synthesisRetryable   Boolean?
  synthesisAttempts    Json              @default("[]")
  synthesisStartedAt   DateTime?
  synthesisUpdatedAt   DateTime?
  synthesisCompletedAt DateTime?
  synthesisExpiresAt   DateTime?
  createdAt            DateTime          @default(now())
  run                  RecommendationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  song                 Song              @relation(fields: [songId], references: [id], onDelete: Restrict)

  @@unique([runId, rank])
  @@unique([runId, songId])
  @@index([songId])
  @@index([synthesisStatus, synthesisUpdatedAt])
}

model User {
  id                 String              @id
  name               String
  email              String              @unique
  emailVerified      Boolean             @default(false)
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sessions           Session[]
  accounts           Account[]
  vocalProfiles      VocalProfile[]
  recommendationRuns RecommendationRun[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
