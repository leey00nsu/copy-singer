generator client {
  provider = "prisma-client"
  output   = "../src/shared/db/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecordingKind {
  USER_TEST
  SONG_SOURCE
  SVC_REFERENCE
  SVC_TARGET
}

enum RecordingStatus {
  PENDING
  READY
  FAILED
  DELETED
}

enum VocalProfileSourceType {
  USER
  SONG
}

enum SongAnalysisStatus {
  PENDING
  READY
  FAILED
}

enum SongLifecycleStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SongSourceStatus {
  DRAFT
  READY
  SUPERSEDED
  UNAVAILABLE
}

enum SongAnalysisJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum CatalogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CatalogEntryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SynthesisStatus {
  PREPARING
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum MediaAssetKind {
  REFERENCE
  SYNTHESIS_REFERENCE
  MIX_RESULT
}

enum MediaAssetStatus {
  READY
  DELETE_PENDING
  DELETED
  FAILED
}

enum MediaCleanupStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum TicketLedgerType {
  SIGNUP_GRANT
  MIXING_DEBIT
  MIXING_REFUND
  ADMIN_ADJUSTMENT
}

enum MixingJobStatus {
  PENDING
  PREPARING
  SUBMITTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
}

enum VocalProfileAnalysisJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum TicketRefundState {
  NONE
  REQUIRED
  REFUNDED
}

enum NotificationType {
  TICKET_CREDIT
  VOCAL_PROFILE_SUCCEEDED
  VOCAL_PROFILE_FAILED
  MIXING_SUCCEEDED
  MIXING_FAILED
}

model Recording {
  id            String          @id @default(uuid()) @db.Uuid
  kind          RecordingKind
  storagePath   String
  mimeType      String
  durationMs    Int?
  sizeBytes     BigInt?
  sampleRate    Int?
  status        RecordingStatus @default(PENDING)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  expiresAt     DateTime?
  mediaAssetId  String?         @unique @db.Uuid
  vocalProfiles VocalProfile[]
  mediaAsset    MediaAsset?     @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([kind, status])
  @@index([createdAt])
  @@index([expiresAt])
}

model VocalProfile {
  id                        String                   @id @default(uuid()) @db.Uuid
  userId                    String?
  profileNumber             Int?
  displayName               String?
  sourceType                VocalProfileSourceType
  recordingId               String                   @db.Uuid
  synthesisReferenceAssetId String?                  @unique @db.Uuid
  minMidi                   Float?
  maxMidi                   Float?
  p10Midi                   Float?
  medianMidi                Float?
  p90Midi                   Float?
  tessituraLowMidi          Float?
  tessituraHighMidi         Float?
  voicedRatio               Float?
  pitchStability            Float?
  clippingRatio             Float?
  rmsDb                     Float?
  descriptors               Json?
  analyzer                  String
  analyzerVersion           String
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  recording                 Recording                @relation(fields: [recordingId], references: [id], onDelete: Restrict)
  synthesisReferenceAsset   MediaAsset?              @relation("VocalProfileSynthesisReference", fields: [synthesisReferenceAssetId], references: [id], onDelete: SetNull)
  user                      User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  song                      Song?
  recommendationRuns        RecommendationRun[]
  mixingJobs                MixingJob[]
  analysisJob               VocalProfileAnalysisJob?

  @@unique([recordingId, analyzer, analyzerVersion])
  @@unique([userId, profileNumber])
  @@index([userId, createdAt])
  @@index([sourceType, createdAt])
}

model Song {
  id                  String               @id @default(uuid()) @db.Uuid
  title               String
  artist              String
  originalKey         String?
  lifecycleStatus     SongLifecycleStatus  @default(DRAFT)
  activeSourceId      String?              @unique @db.Uuid
  currentAnalysisId   String?              @unique @db.Uuid
  createdByUserId     String?
  catalogOrder        Int                  @unique
  vocalProfileId      String?              @unique @db.Uuid
  targetAssetId       String?              @unique @db.Uuid
  analysisStatus      SongAnalysisStatus   @default(PENDING)
  metadata            Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  activeSource        SongSource?          @relation("ActiveSongSource", fields: [activeSourceId], references: [id], onDelete: SetNull)
  currentAnalysis     SongAnalysis?        @relation("CurrentSongAnalysis", fields: [currentAnalysisId], references: [id], onDelete: SetNull)
  createdBy           User?                @relation("SongCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  vocalProfile        VocalProfile?        @relation(fields: [vocalProfileId], references: [id], onDelete: SetNull)
  targetAsset         CatalogTargetAsset?  @relation(fields: [targetAssetId], references: [id], onDelete: SetNull)
  sources             SongSource[]         @relation("SongSources")
  analyses            SongAnalysis[]       @relation("SongAnalyses")
  catalogEntries      CatalogEntry[]
  recommendationItems RecommendationItem[]
  mixingJobs          MixingJob[]

  @@unique([title, artist])
  @@index([lifecycleStatus, createdAt])
  @@index([createdByUserId, createdAt])
  @@index([analysisStatus, catalogOrder])
}

model SongSource {
  id              String              @id @default(uuid()) @db.Uuid
  songId          String              @db.Uuid
  revision        Int
  sourceUrl       String
  sourceVideoId   String              @unique
  sourceLabel     String
  status          SongSourceStatus    @default(DRAFT)
  createdByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  song            Song                @relation("SongSources", fields: [songId], references: [id], onDelete: Restrict)
  activeForSong   Song?               @relation("ActiveSongSource")
  createdBy       User?               @relation("SongSourceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  analyses        SongAnalysis[]
  analysisJob     SongAnalysisJob?
  targetAsset     CatalogTargetAsset?

  @@unique([songId, revision])
  @@index([songId, status, createdAt])
  @@index([createdByUserId, createdAt])
}

model SongAnalysis {
  id                  String               @id @default(uuid()) @db.Uuid
  songId              String               @db.Uuid
  sourceId            String               @db.Uuid
  status              SongAnalysisStatus   @default(PENDING)
  pipelineContract    String
  durationMs          Int?
  sampleRate          Int?
  sourceSizeBytes     BigInt?
  minMidi             Float?
  maxMidi             Float?
  p10Midi             Float?
  medianMidi          Float?
  p90Midi             Float?
  tessituraLowMidi    Float?
  tessituraHighMidi   Float?
  voicedRatio         Float?
  pitchStability      Float?
  clippingRatio       Float?
  rmsDb               Float?
  analyzer            String?
  analyzerVersion     String?
  descriptors         Json?
  pipelineMetadata    Json?
  cleanupConfirmed    Boolean              @default(false)
  errorCode           String?
  errorDetail         String?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  song                Song                 @relation("SongAnalyses", fields: [songId], references: [id], onDelete: Restrict)
  source              SongSource           @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  currentForSong      Song?                @relation("CurrentSongAnalysis")
  analysisJob         SongAnalysisJob?
  recommendationItems RecommendationItem[]

  @@unique([sourceId, pipelineContract])
  @@index([songId, status, createdAt])
  @@index([status, updatedAt])
}

model SongAnalysisJob {
  id             String                @id @default(uuid()) @db.Uuid
  sourceId       String                @unique @db.Uuid
  analysisId     String?               @unique @db.Uuid
  status         SongAnalysisJobStatus @default(PENDING)
  idempotencyKey String                @unique
  attempts       Int                   @default(0)
  maxAttempts    Int                   @default(3)
  nextAttemptAt  DateTime              @default(now())
  leaseOwner     String?
  leaseExpiresAt DateTime?
  heartbeatAt    DateTime?
  errorCode      String?
  errorDetail    String?
  retryable      Boolean?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  source         SongSource            @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  analysis       SongAnalysis?         @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt, leaseExpiresAt, createdAt])
}

model Catalog {
  id        String         @id @default(uuid()) @db.Uuid
  slug      String         @unique
  name      String
  issue     String?
  status    CatalogStatus  @default(DRAFT)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  entries   CatalogEntry[]

  @@index([status, createdAt])
}

model CatalogEntry {
  id          String             @id @default(uuid()) @db.Uuid
  catalogId   String             @db.Uuid
  songId      String             @db.Uuid
  position    Int
  status      CatalogEntryStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  catalog     Catalog            @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  song        Song               @relation(fields: [songId], references: [id], onDelete: Restrict)

  @@unique([catalogId, position])
  @@unique([catalogId, songId])
  @@index([catalogId, status, position])
  @@index([songId, status])
}

model RecommendationRun {
  id                 String               @id @default(uuid()) @db.Uuid
  userId             String?
  userVocalProfileId String               @db.Uuid
  scoringVersion     String
  createdAt          DateTime             @default(now())
  userVocalProfile   VocalProfile         @relation(fields: [userVocalProfileId], references: [id], onDelete: Restrict)
  user               User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items              RecommendationItem[]

  @@unique([userVocalProfileId])
  @@index([userId, createdAt])
}

model RecommendationItem {
  id                   String            @id @default(uuid()) @db.Uuid
  runId                String            @db.Uuid
  songId               String            @db.Uuid
  songAnalysisId       String?           @db.Uuid
  rank                 Int
  originalKeyScore     Float
  adjustedScore        Float
  recommendedShift     Int
  reasonCodes          Json
  metrics              Json
  synthesisStatus      SynthesisStatus?
  synthesisJobId       String?
  synthesisErrorCode   String?
  synthesisErrorDetail String?
  synthesisRetryable   Boolean?
  synthesisAttempts    Json              @default("[]")
  synthesisStartedAt   DateTime?
  synthesisUpdatedAt   DateTime?
  synthesisCompletedAt DateTime?
  synthesisExpiresAt   DateTime?
  createdAt            DateTime          @default(now())
  run                  RecommendationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  song                 Song              @relation(fields: [songId], references: [id], onDelete: Restrict)
  songAnalysis         SongAnalysis?     @relation(fields: [songAnalysisId], references: [id], onDelete: Restrict)
  mixingJobs           MixingJob[]

  @@unique([runId, rank])
  @@unique([runId, songId])
  @@index([songId])
  @@index([songAnalysisId])
  @@index([synthesisStatus, synthesisUpdatedAt])
}

model User {
  id                       String                    @id
  name                     String
  email                    String                    @unique
  emailVerified            Boolean                   @default(false)
  image                    String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  ticketBalance            Int                       @default(0)
  nextVocalProfileNumber   Int                       @default(1)
  sessions                 Session[]
  accounts                 Account[]
  vocalProfiles            VocalProfile[]
  recommendationRuns       RecommendationRun[]
  mediaAssets              MediaAsset[]
  ticketLedgers            TicketLedger[]            @relation("TicketOwner")
  ticketActions            TicketLedger[]            @relation("TicketActor")
  mixingJobs               MixingJob[]
  vocalProfileAnalysisJobs VocalProfileAnalysisJob[]
  notifications            Notification[]
  createdSongs             Song[]                    @relation("SongCreatedBy")
  createdSongSources       SongSource[]              @relation("SongSourceCreatedBy")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model MediaAsset {
  id                       String                    @id @default(uuid()) @db.Uuid
  userId                   String
  kind                     MediaAssetKind
  provider                 String                    @default("LEEMAGE")
  externalProjectId        String
  externalFileId           String
  externalUrl              String
  fileName                 String
  mimeType                 String
  sizeBytes                BigInt
  status                   MediaAssetStatus          @default(READY)
  lastError                String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recording                Recording?
  synthesisVocalProfile    VocalProfile?             @relation("VocalProfileSynthesisReference")
  cleanupJobs              MediaCleanupJob[]
  referenceMixingJobs      MixingJob[]               @relation("MixingReference")
  resultMixingJobs         MixingJob[]               @relation("MixingResult")
  vocalProfileAnalysisJobs VocalProfileAnalysisJob[] @relation("VocalProfileAnalysisSource")

  @@unique([externalProjectId, externalFileId])
  @@index([userId, kind, createdAt])
  @@index([status, updatedAt])
}

model CatalogTargetAsset {
  id                String           @id @default(uuid()) @db.Uuid
  provider          String           @default("LEEMAGE")
  externalProjectId String
  externalFileId    String
  externalUrl       String
  fileName          String
  mimeType          String
  sizeBytes         BigInt
  sha256            String
  sourceVideoId     String
  sourceId          String?          @unique @db.Uuid
  status            MediaAssetStatus @default(READY)
  lastError         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
  song              Song?
  source            SongSource?      @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  mixingJobs        MixingJob[]      @relation("MixingTarget")

  @@unique([externalProjectId, externalFileId])
  @@index([status, updatedAt])
  @@index([sourceVideoId])
}

model MediaCleanupJob {
  id            String             @id @default(uuid()) @db.Uuid
  mediaAssetId  String             @db.Uuid
  status        MediaCleanupStatus @default(PENDING)
  attempts      Int                @default(0)
  nextAttemptAt DateTime           @default(now())
  lastError     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  mediaAsset    MediaAsset         @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

model TicketLedger {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String
  type           TicketLedgerType
  amount         Int
  balanceAfter   Int
  idempotencyKey String           @unique
  mixingJobId    String?          @db.Uuid
  actorUserId    String?
  reason         String
  createdAt      DateTime         @default(now())
  user           User             @relation("TicketOwner", fields: [userId], references: [id], onDelete: Cascade)
  actorUser      User?            @relation("TicketActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  mixingJob      MixingJob?       @relation(fields: [mixingJobId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([mixingJobId])
  @@index([actorUserId, createdAt])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String
  type      NotificationType
  title     String
  message   String
  href      String
  sourceId  String?
  dedupeKey String           @unique
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt, createdAt])
}

model VocalProfileAnalysisJob {
  id             String                        @id @default(uuid()) @db.Uuid
  userId         String
  recordingId    String                        @unique @db.Uuid
  sourceAssetId  String?                       @db.Uuid
  vocalProfileId String?                       @unique @db.Uuid
  status         VocalProfileAnalysisJobStatus @default(PENDING)
  idempotencyKey String
  attempts       Int                           @default(0)
  maxAttempts    Int                           @default(3)
  nextAttemptAt  DateTime                      @default(now())
  leaseOwner     String?
  leaseExpiresAt DateTime?
  heartbeatAt    DateTime?
  errorCode      String?
  errorDetail    String?
  retryable      Boolean?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  user           User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceAsset    MediaAsset?                   @relation("VocalProfileAnalysisSource", fields: [sourceAssetId], references: [id], onDelete: SetNull)
  vocalProfile   VocalProfile?                 @relation(fields: [vocalProfileId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([status, nextAttemptAt, leaseExpiresAt, createdAt])
  @@index([userId, createdAt])
}

model MixingJob {
  id                   String              @id @default(uuid()) @db.Uuid
  userId               String
  vocalProfileId       String              @db.Uuid
  songId               String              @db.Uuid
  recommendationItemId String?             @db.Uuid
  referenceAssetId     String              @db.Uuid
  targetAssetId        String?             @db.Uuid
  resultAssetId        String?             @db.Uuid
  status               MixingJobStatus     @default(PENDING)
  ticketCost           Int
  refundState          TicketRefundState   @default(NONE)
  idempotencyKey       String
  modalJobId           String?
  attempts             Int                 @default(0)
  maxAttempts          Int                 @default(3)
  nextAttemptAt        DateTime            @default(now())
  retryable            Boolean?
  leaseOwner           String?
  leaseExpiresAt       DateTime?
  heartbeatAt          DateTime?
  errorCode            String?
  errorDetail          String?
  submittedAt          DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocalProfile         VocalProfile        @relation(fields: [vocalProfileId], references: [id], onDelete: Restrict)
  song                 Song                @relation(fields: [songId], references: [id], onDelete: Restrict)
  recommendationItem   RecommendationItem? @relation(fields: [recommendationItemId], references: [id], onDelete: SetNull)
  referenceAsset       MediaAsset          @relation("MixingReference", fields: [referenceAssetId], references: [id], onDelete: Restrict)
  targetAsset          CatalogTargetAsset? @relation("MixingTarget", fields: [targetAssetId], references: [id], onDelete: Restrict)
  resultAsset          MediaAsset?         @relation("MixingResult", fields: [resultAssetId], references: [id], onDelete: SetNull)
  ticketEntries        TicketLedger[]

  @@unique([userId, idempotencyKey])
  @@index([status, nextAttemptAt, leaseExpiresAt, createdAt])
  @@index([userId, createdAt])
  @@index([recommendationItemId, createdAt])
  @@index([targetAssetId])
  @@index([modalJobId])
}
