# SoulX-Singer Modal API used by the durable mixing worker and admin custom mixing.
# Both values are required when AI mixing is enabled. Keep the key server-only.
MODAL_API_URL=https://your-workspace--soulx-singer-svc-web.modal.run
MODAL_API_KEY=replace-with-the-value-from-soulx-api-secret

# Optional FFmpeg executable path for final AAC/M4A encoding. Defaults to `ffmpeg` on PATH.
FFMPEG_BIN=ffmpeg

# Local PostgreSQL container settings used only by docker-compose.yml.
POSTGRES_DB=copy_singer
POSTGRES_USER=copy_singer
POSTGRES_PASSWORD=copy_singer_dev
POSTGRES_PORT=5433

# PostgreSQL connection shared by the Next.js server and all durable workers.
# Replace localhost with the production database connection when deploying.
DATABASE_URL=postgresql://copy_singer:copy_singer_dev@localhost:5433/copy_singer?schema=public

# Modal vocal-profile analyzer used by the durable vocal-analysis worker.
# The URL is required; leave the dedicated key blank to reuse MODAL_API_KEY.
VOCAL_PROFILE_MODAL_URL=https://your-workspace--copy-singer-vocal-profile-analyzer-fastapi-app.modal.run
VOCAL_PROFILE_MODAL_API_KEY=

# Modal song-catalog analyzer used by the durable song-analysis worker.
# Leave the dedicated key blank to reuse MODAL_API_KEY.
SONG_ANALYSIS_MODAL_URL=https://your-workspace--copy-singer-catalog-analyzer-fastapi-app.modal.run
SONG_ANALYSIS_MODAL_API_KEY=

# Song-analysis worker polling, concurrency and lease controls.
# Defaults: 2500 ms, 1 worker lane and a 300-second lease.
SONG_ANALYSIS_POLL_INTERVAL_MS=2500
SONG_ANALYSIS_WORKER_CONCURRENCY=1
SONG_ANALYSIS_LEASE_SECONDS=300

# Better Auth public origin and server secret. Production requires all four auth values.
# Use the deployed HTTPS origin for BETTER_AUTH_URL and a random 32+ character secret.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Comma-separated Google account emails allowed to access administrator routes.
ADMIN_EMAILS=admin@example.com

# Local automated testing bypass. It is ignored outside development and test.
DEV_AUTH_BYPASS_ENABLED=false
DEV_AUTH_BYPASS_USER_ID=

# Leemage project used for private vocal references, catalog targets and mixing results.
# The base URL has the shown default, while the API key and project ID are required.
LEEMAGE_BASE_URL=https://leemage.leey00nsu.com/api/v1
LEEMAGE_API_KEY=replace-with-leemage-api-key
LEEMAGE_PROJECT_ID=replace-with-leemage-project-id

# Product ticket policy. Grants apply once at signup; costs apply per accepted request.
SIGNUP_VOCAL_ANALYSIS_TICKET_GRANT=5
SIGNUP_MIXING_TICKET_GRANT=1
VOCAL_PROFILE_ANALYSIS_TICKET_COST=1
MIXING_TICKET_COST=1

# Durable AI-mixing worker controls.
# Defaults: 1 lane, 3 attempts, a 120-second lease and 5000 ms polling.
MIXING_WORKER_CONCURRENCY=1
MIXING_MAX_ATTEMPTS=3
MIXING_LEASE_SECONDS=120
MIXING_POLL_INTERVAL_MS=5000

# Durable vocal-profile analysis worker controls.
# Defaults: 1 lane, 3 attempts and a 300-second lease.
VOCAL_PROFILE_ANALYSIS_WORKER_CONCURRENCY=1
VOCAL_PROFILE_ANALYSIS_MAX_ATTEMPTS=3
VOCAL_PROFILE_ANALYSIS_LEASE_SECONDS=300
