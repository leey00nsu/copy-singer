MODAL_API_URL=https://dbstndla1212--soulx-singer-svc-web.modal.run
MODAL_API_KEY=replace-with-the-value-from-soulx-api-secret
FFMPEG_BIN=ffmpeg

# Local PostgreSQL (development only)
POSTGRES_DB=copy_singer
POSTGRES_USER=copy_singer
POSTGRES_PASSWORD=copy_singer_dev
POSTGRES_PORT=5433
DATABASE_URL=postgresql://copy_singer:copy_singer_dev@localhost:5433/copy_singer?schema=public

# Vocal profile analyzer backend (server only)
# Development/test defaults to local when omitted. Production must set local or modal explicitly.
VOCAL_PROFILE_ANALYZER_BACKEND=local

# Local CPU vocal profile analyzer (used only when backend=local, including mixing song-target preparation)
VOCAL_PROFILE_API_PORT=8001
VOCAL_PROFILE_API_URL=http://localhost:8001

# Modal CPU vocal profile analyzer (required when backend=modal; used for vocal analysis and mixing song-target preparation)
# Uses the same server-side X-API-Key secret as the existing SoulX Modal API by default.
VOCAL_PROFILE_MODAL_URL=https://your-workspace--copy-singer-vocal-profile-analyzer-fastapi-app.modal.run
# Optional override. When omitted, MODAL_API_KEY is reused.
VOCAL_PROFILE_MODAL_API_KEY=

# Modal L4 song catalog analyzer (server only)
SONG_ANALYSIS_MODAL_URL=https://your-workspace--copy-singer-catalog-analyzer-fastapi-app.modal.run
# Optional override. When omitted, MODAL_API_KEY is reused.
SONG_ANALYSIS_MODAL_API_KEY=
SONG_ANALYSIS_POLL_INTERVAL_MS=2500

# Better Auth + Google OAuth (server only)
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
# Local automated UI testing only. Ignored unless NODE_ENV is development/test.
# When enabled, the configured user is forced for every request, so interactive logout is unavailable.
DEV_AUTH_BYPASS_ENABLED=false
DEV_AUTH_BYPASS_USER_ID=
ADMIN_EMAILS=admin@example.com
ENABLE_DEV_SVC=true

# Leemage media storage (server only)
LEEMAGE_BASE_URL=https://leemage.leey00nsu.com/api/v1
LEEMAGE_API_KEY=replace-with-leemage-api-key
LEEMAGE_PROJECT_ID=replace-with-leemage-project-id

# Product ticket constants
SIGNUP_TICKET_GRANT=1
MIXING_TICKET_COST=1
MIXING_WORKER_CONCURRENCY=1
MIXING_MAX_ATTEMPTS=3
MIXING_LEASE_SECONDS=120
MIXING_POLL_INTERVAL_MS=5000

# Durable vocal-profile analysis worker
VOCAL_PROFILE_ANALYSIS_WORKER_CONCURRENCY=1
VOCAL_PROFILE_ANALYSIS_MAX_ATTEMPTS=3
VOCAL_PROFILE_ANALYSIS_LEASE_SECONDS=300
