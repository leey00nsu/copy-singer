{
  "projectName": "copy-singer",
  "projectType": "multi",
  "components": [
    "web",
    "modal-api",
    "data"
  ],
  "lang": "ko",
  "createdAt": "2026-08-05",
  "docsRepo": "embedded",
  "workflow": {
    "mode": "local",
    "requireWorktree": false,
    "codeDirtyScope": "auto",
    "taskCommitGate": "warn",
    "prePrReview": {
      "evidenceMode": "path_required",
      "reviewer": {
        "type": "subagent",
        "model": "inherit",
        "reasoningEffort": "high",
        "onUnavailable": "inherit"
      }
    },
    "baseBranch": "main",
    "completionStrategy": "local-ff",
    "deleteFeatureBranchAfterMerge": true,
    "postMergeChecks": [
      {
        "command": "pnpm",
        "args": [
          "test"
        ]
      },
      {
        "command": "pnpm",
        "args": [
          "run",
          "lint"
        ]
      },
      {
        "command": "pnpm",
        "args": [
          "exec",
          "tsc",
          "--noEmit"
        ]
      }
    ]
  },
  "pr": {
    "screenshots": {
      "upload": false
    }
  },
  "approval": {
    "mode": "category",
    "default": "skip",
    "requireCheckCategories": [
      "spec_approve",
      "implementation_approve",
      "local_merge"
    ]
  }
}
