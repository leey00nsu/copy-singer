{
  "name": "copy-singer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,worker \"pnpm run dev:web\" \"pnpm run worker:mixing\"",
    "dev:web": "next dev",
    "build": "next build",
    "start": "concurrently --kill-others-on-fail --names web,worker \"pnpm run start:web\" \"pnpm run worker:mixing\"",
    "start:web": "next start",
    "worker:mixing": "node --conditions react-server --import tsx scripts/mixing-worker.ts",
    "verify:feature-config": "node --conditions react-server --import tsx scripts/verify-feature-config.ts",
    "test": "pnpm run build && tsx --test tests/vocal-profile-contract.test.ts tests/vocal-profile-visualization.test.ts tests/long-audio-upload.test.ts tests/vocal-profile-recorder.test.ts tests/audio-waveform-player.test.ts tests/mixing-reference.test.ts && pnpm run test:base-ui && pnpm run test:process-scripts && pnpm run test:vocal-profile-history && pnpm run test:catalog && pnpm run test:key-fit && pnpm run test:recommendation && pnpm run test:auth:db && pnpm run test:media && pnpm run test:tickets && pnpm run test:mixing:db && pnpm run test:mixing:ui && pnpm run test:admin",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:verify": "tsx scripts/verify-database.ts",
    "catalog:import": "tsx scripts/import-song-catalog.ts",
    "catalog:init-profiles": "tsx scripts/init-song-profile-artifact.ts",
    "catalog:analyze": "tsx scripts/analyze-song-catalog.ts",
    "catalog:verify": "tsx scripts/verify-song-catalog.ts",
    "catalog:clear-db-profiles": "tsx scripts/clear-song-profile-records.ts",
    "test:catalog": "tsx --test tests/song-catalog.test.ts",
    "test:key-fit": "tsx --test tests/key-fit-scoring.test.ts",
    "test:vocal-profile-history": "tsx --test tests/vocal-profile-history-ui.test.tsx && node --conditions react-server --import tsx --test tests/private-audio-proxy.test.ts tests/vocal-profile-history.integration.ts",
    "test:base-ui": "tsx --test tests/base-ui-link-button.test.ts",
    "test:process-scripts": "tsx --test tests/process-scripts.test.ts",
    "test:recommendation": "tsx --test tests/recommendation-ranking.test.ts tests/recommendation-synthesis.test.ts tests/recommendation-ui.test.tsx",
    "test:recommendation:db": "node --conditions react-server --import tsx --test tests/recommendation-persistence.integration.ts tests/recommendation-synthesis.integration.ts",
    "test:auth:db": "node --conditions react-server --import tsx --test tests/auth-ownership.integration.ts",
    "test:media": "node --conditions react-server --import tsx --test tests/leemage-client.test.ts tests/leemage-media.integration.ts",
    "test:tickets": "tsx --test tests/ticket-ledger-ui.test.tsx && node --conditions react-server --import tsx --test tests/ticket-ledger.integration.ts",
    "test:mixing:db": "node --conditions react-server --import tsx --test tests/mixing-queue.integration.ts",
    "test:mixing:ui": "tsx --test tests/mixing-history-ui.test.tsx",
    "test:admin": "tsx --test tests/admin-ui.test.tsx && node --conditions react-server --import tsx --test tests/admin-operations.integration.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@wavesurfer/react": "^1.0.12",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "17.4.2",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "server-only": "0.0.1",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "wavesurfer.js": "^7.12.11"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.20.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "^10.0.4",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "prisma": "7.9.1",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
